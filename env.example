# Budget Engineer — environment template
# All keys here are FREE-TIER ONLY. Never commit real secrets.
# The app is local-first: every key is optional and read only in the browser
# (no backend). Unset providers fall back to the deterministic local engines.

# — Free-tier LLM routing (src/lib/ai/remote-providers.ts) —
OPENROUTER_API_KEY=free-tier-key
BYTEZ_API_KEY=free
NVIDIA_API_KEY=free-credits
GROQ_API_KEY=free
HF_TOKEN=free

# — Optional Africa ConTech Hub cloud backend (Vite exposes these to the browser) —
# The web client reads only VITE_-prefixed vars; VITE_SUPABASE_URL/_ANON_KEY enable the
# optional sync, and VITE_API_URL overrides the default /api proxy target.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# — Optional observability (local-first analogue is Dexie traces in src/engine/rag/tracing.ts) —
LANGFUSE_PUBLIC_KEY=free
LANGFUSE_SECRET_KEY=free
LANGFUSE_HOST=https://cloud.langfuse.com

# — lib/llm/freeRouter.ts optional adapters (both default OFF; memory cache + local log used otherwise) —
REDIS_URL=

# — Vite build surface (defaults are fine) —
VITE_APP_NAME=Budget Engineer
